  "solution": [
    "stop = [",
    "    [1, \"학교\", 0],",
    "    [2, \"도서관\", 7],",
    "    [3, \"시장\", 15],",
    "    [4, \"시청\", 24],",
    "    [5, \"터미널\", 38]",
    "]",
    "",
    "a = int(input(\"승차 정류장: \"))",
    "b = int(input(\"하차 정류장: \"))",
    "",
    "if a == b:",
    "    print(\"같은 정류장입니다\")",
    "elif a < b:",
    "    time = stop[b-1][2] - stop[a-1][2]",
    "    print(stop[a-1][1], \"→\", stop[b-1][1])",
    "    print(\"정류장 수:\", b - a)",
    "    print(\"소요 시간:\", time, \"분\")",
    "else:",
    "    print(\"반대 방향입니다\")"
