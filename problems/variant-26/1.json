  "solution": [
    "hour = int(input(\"시: \"))",
    "minute = int(input(\"분: \"))",
    "",
    "angle = abs((hour % 12) * 30 + minute * 0.5 - minute * 6)",
    "if angle > 180:",
    "    angle = 360 - angle",
    "",
    "if hour < 0 or hour > 23 or minute < 0 or minute > 59:",
    "    print(\"시각 오류\")",
    "elif angle == 0:",
    "    print(\"두 바늘이 겹칩니다\")",
    "elif angle == 90:",
    "    print(\"두 바늘이 직각입니다\")",
    "elif angle == 180:",
    "    print(\"두 바늘이 일직선입니다\")",
    "else:",
    "    print(\"두 바늘 사이의 각도:\", angle, \"도\")"
  ]
