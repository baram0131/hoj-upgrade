    {
      "type": "forbid_call",
      "name": "sum",
      "desc": "sum() 함수 사용 금지"
    }
  ],
  "solution": [
    "n = int(input(\"n 입력: \"))",
    "total = 0",
    "i = 1",
    "while i <= n:",
    "    total += i",
    "    i += 1",
    "print(\"합계:\", total)"
  ]
