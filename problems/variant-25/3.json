  "solution": [
    "cats = [\"식비\", \"교통\", \"문화\", \"기타\"]",
    "book = [",
    "    [1, 320000, 85000, 60000, 40000],",
    "    [2, 290000, 90000, 120000, 35000],",
    "    [3, 350000, 80000, 45000, 70000],",
    "    [4, 310000, 95000, 150000, 30000],",
    "    [5, 400000, 70000, 50000, 60000],",
    "    [6, 330000, 88000, 110000, 52000]",
    "]",
    "",
    "m = int(input(\"조회할 월: \"))",
    "",
    "if m < 2 or m > 6:",
    "    print(\"조회할 수 없는 달\")",
    "else:",
    "    now = sum(book[m-1][1:])",
    "    prev = sum(book[m-2][1:])",
    "    diff = now - prev",
    "    rate = round(abs(diff) / prev * 100, 1)",
    "",
    "    best = 0",
    "    name = \"\"",
    "    for i in range(4):",
    "        if book[m-1][i+1] > best:",
    "            best = book[m-1][i+1]",
    "            name = cats[i]",
    "",
    "    print(m, \"월 지출:\", now, \"원\")",
    "    if diff > 0:",
    "        print(\"지난달보다\", diff, \"원 증가\")",
    "        print(\"증가율:\", rate, \"%\")",
    "    elif diff < 0:",
    "        print(\"지난달보다\", -diff, \"원 감소\")",
    "        print(\"감소율:\", rate, \"%\")",
    "    else:",
    "        print(\"지난달과 같음\")",
    "    print(\"가장 많이 쓴 항목:\", name)"
  ]
}
