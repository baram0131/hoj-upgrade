  "solution": [
    "mine = [",
    "    [0, 1, 0, 0, 1],",
    "    [0, 0, 0, 1, 0],",
    "    [1, 0, 0, 0, 0],",
    "    [0, 0, 1, 0, 1]",
    "]",
    "",
    "r = int(input(\"행 입력: \"))",
    "c = int(input(\"열 입력: \"))",
    "",
    "if r < 1 or r > 4 or c < 1 or c > 5:",
    "    print(\"없는 칸\")",
    "elif mine[r-1][c-1] == 1:",
    "    print(\"지뢰입니다!\")",
    "else:",
    "    count = 0",
    "    for i in range(r - 2, r + 1):",
    "        for j in range(c - 2, c + 1):",
    "            if 0 <= i < 4 and 0 <= j < 5:",
    "                count = count + mine[i][j]",
    "    print(\"주변 지뢰:\", count, \"개\")"
  ]
