  "solution": [
    "score = [",
    "    [1, \"민준\", 88, 92, 79],",
    "    [2, \"서연\", 95, 85, 91],",
    "    [3, \"도윤\", 76, 98, 85],",
    "    [4, \"하은\", 90, 88, 97]",
    "]",
    "",
    "k = int(input(\"과목 번호 입력: \"))",
    "",
    "total = 0",
    "best = 0",
    "best_name = \"\"",
    "for row in score:",
    "    total = total + row[k+1]",
    "    if row[k+1] > best:",
    "        best = row[k+1]",
    "        best_name = row[1]",
    "avg = total / len(score)",
    "",
    "print(\"과목 평균:\", avg)",
    "print(\"최고 점수:\", best)",
