  "solution": [
    "stock = [",
    "    [1, \"가나전자\", 12, 10, 8, 11, 15, 9, 13],",
    "    [2, \"다라식품\", 20, 22, 19, 18, 17, 16, 15],",
    "    [3, \"마바건설\", 5, 9, 4, 8, 3, 10, 6],",
    "    [4, \"사아화학\", 30, 28, 25, 25, 20, 18, 15]",
    "]",
    "",
    "n = int(input(\"종목 번호 입력: \"))",
    "",
    "low = stock[n-1][2]",
    "low_day = 1",
    "best = 0",
    "buy = 0",
    "sell = 0",
    "for d in range(2, 8):",
    "    price = stock[n-1][d+1]",
    "    if price - low > best:",
    "        best = price - low",
    "        buy = low_day",
    "        sell = d",
    "    if price < low:",
    "        low = price",
    "        low_day = d",
    "",
    "print(\"종목:\", stock[n-1][1])",
    "if best > 0:",
    "    print(buy, \"일에 사서\", sell, \"일에 팔면\", best, \"원 이익\")",
    "else:",
    "    print(\"이익을 낼 수 없습니다\")"
  ]
