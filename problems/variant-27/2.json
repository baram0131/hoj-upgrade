  "solution": [
    "for row in range(1, 10):",
    "    for col in range(1, 10):",
    "        if (row - 5) ** 2 + (col - 5) ** 2 <= 1:",
    "            print(\"@\", end=\" \")",
    "        elif (row - 5) ** 2 + (col - 5) ** 2 <= 6.25:",
