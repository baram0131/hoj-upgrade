  "solution": [
    "for row in range(1, 10):",
    "    for col in range(1, 10):",
    "        if max(abs(row - 5), abs(col - 5)) == 0:",
    "            print(\"@\", end=\" \")",
    "        elif max(abs(row - 5), abs(col - 5)) % 2 == 0:",
    "            print(\"*\", end=\" \")",
    "        else:",
    "            print(\" \", end=\" \")",
    "    print()"
