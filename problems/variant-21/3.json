  "solution": [
    "data = [",
    "    [1, \"가온\", 88, 92, 85],",
    "    [2, \"나래\", 95, 78, 90],",
    "    [3, \"다솜\", 70, 85, 80],",
    "    [4, \"라온\", 92, 88, 85],",
    "    [5, \"마루\", 60, 75, 70]",
    "]",
    "",
    "n = int(input(\"학생 번호 입력: \"))",
    "",
    "name = data[n-1][1]",
    "my = data[n-1][2] + data[n-1][3] + data[n-1][4]",
    "",
    "rank = 1",
    "total = 0",
    "for row in data:",
    "    t = row[2] + row[3] + row[4]",
    "    total = total + t",
    "    if t > my:",
    "        rank = rank + 1",
    "avg = total / len(data)",
    "",
    "print(\"이름:\", name)",
    "print(\"총점:\", my)",
    "print(\"석차:\", rank, \"등\")",
    "print(\"반 평균 총점:\", avg)",
    "if rank == 1:",
    "    print(\"반에서 1등입니다\")",
    "elif my >= avg:",
    "    print(\"평균 이상입니다\")",
    "else:",
    "    print(\"평균 미만입니다\")"
  ]
