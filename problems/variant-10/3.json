  "solution": [
    "seat = [",
    "    [1, 0, 0, 1],",
    "    [0, 1, 0, 0],",
    "    [0, 0, 1, 1]",
    "]",
    "",
    "r = int(input(\"행 입력: \"))",
    "c = int(input(\"열 입력: \"))",
    "",
    "if r < 1 or r > 3 or c < 1 or c > 4:",
    "    print(\"없는 좌석\")",
    "elif seat[r-1][c-1] == 1:",
    "    print(\"이미 예매된 좌석\")",
    "else:",
    "    print(\"예매 가능\")"
