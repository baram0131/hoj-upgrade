  "solution": [
    "city = [",
    "    [1, \"서울\", -2, 13, 26, 15],",
    "    [2, \"부산\", 4, 15, 25, 18],",
    "    [3, \"강릉\", 0, 12, 24, 16],",
    "    [4, \"제주\", 7, 15, 27, 19]",
    "]",
    "",
    "n = int(input(\"도시 번호 입력: \"))",
    "",
    "name = city[n-1][1]",
    "temps = city[n-1][2:]",
    "avg = sum(temps) / len(temps)",
    "diff = max(temps) - min(temps)",
    "",
    "print(\"도시:\", name)",
    "print(\"평균 기온:\", avg)",
    "print(\"연교차:\", diff)",
    "if diff >= 25:",
    "    print(\"연교차가 큽니다\")",
    "elif diff >= 21:",
    "    print(\"연교차가 보통입니다\")",
    "else:",
    "    print(\"연교차가 작습니다\")"
