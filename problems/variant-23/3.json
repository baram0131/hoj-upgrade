  "solution": [
    "vote = [",
    "    [1, 12, 8, 5],",
    "    [2, 7, 14, 4],",
    "    [3, 10, 9, 6],",
    "    [4, 6, 11, 8],",
    "    [5, 9, 7, 9]",
    "]",
    "",
    "k = int(input(\"후보 번호 입력: \"))",
    "",
    "my = 0",
    "total = 0",
    "for row in vote:",
    "    my = my + row[k]",
    "    total = total + row[1] + row[2] + row[3]",
    "",
    "best = 0",
    "for j in range(1, 4):",
    "    s = 0",
    "    for row in vote:",
    "        s = s + row[j]",
    "    if s > best:",
    "        best = s",
    "",
    "rate = round(my / total * 100, 1)",
    "",
    "print(\"후보\", k, \"득표:\", my, \"표\")",
    "print(\"득표율:\", rate, \"%\")",
    "if my == best:",
    "    print(\"당선\")",
    "elif best - my <= 10:",
    "    print(\"아쉽게 낙선 (1위와\", best - my, \"표 차이)\")",
    "else:",
    "    print(\"낙선 (1위와\", best - my, \"표 차이)\")"
  ]
