  "solution": [
    "guess = int(input(\"세 자리 수 입력: \"))",
    "",
    "a = guess // 100",
    "b = guess // 10 % 10",
    "c = guess % 10",
    "",
    "strike = 0",
    "ball = 0",
    "if a == 4:",
    "    strike = strike + 1",
    "if a == 7 or a == 2:",
    "    ball = ball + 1",
    "if b == 7:",
    "    strike = strike + 1",
    "if b == 4 or b == 2:",
    "    ball = ball + 1",
    "if c == 2:",
    "    strike = strike + 1",
    "if c == 4 or c == 7:",
    "    ball = ball + 1",
    "",
    "if guess < 100 or guess > 999 or a == b or b == c or a == c:",
    "    print(\"잘못된 입력\")",
    "elif strike == 3:",
    "    print(\"정답입니다!\")",
    "elif strike == 0 and ball == 0:",
    "    print(\"아웃\")",
    "else:",
    "    print(strike, \"스트라이크\", ball, \"볼\")"
  ]
