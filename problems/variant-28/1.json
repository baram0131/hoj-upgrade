  "solution": [
    "s = input(\"윷 결과: \")",
    "flat = s.count(\"0\")",
    "",
    "if len(s) != 4 or s.count(\"0\") + s.count(\"1\") != 4:",
    "    print(\"잘못된 입력\")",
    "elif s == \"0111\":",
    "    print(\"빽도: 1칸 뒤로\")",
    "elif flat == 1:",
    "    print(\"도: 1칸 앞으로\")",
    "elif flat == 2:",
    "    print(\"개: 2칸 앞으로\")",
    "elif flat == 3:",
    "    print(\"걸: 3칸 앞으로\")",
    "elif flat == 4:",
    "    print(\"윷: 4칸 앞으로\")",
    "else:",
    "    print(\"모: 5칸 앞으로\")"
  ]
