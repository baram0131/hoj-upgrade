  "solution": [
    "days = [\"월\", \"화\", \"수\", \"목\", \"금\"]",
    "table = [",
    "    [\"국어\", \"수학\", \"영어\", \"정보\", \"체육\"],",
    "    [\"수학\", \"영어\", \"과학\", \"국어\", \"음악\"],",
    "    [\"영어\", \"정보\", \"국어\", \"수학\", \"미술\"],",
