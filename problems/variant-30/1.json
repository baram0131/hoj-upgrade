      "type": "if_elif_else",
      "elif": 2,
      "desc": "if~elif~else문을 이용한 결과 출력"
    }
  ],
  "solution": [
    "price = int(input(\"물건값: \"))",
    "paid = int(input(\"낸 돈: \"))",
    "",
    "change = paid - price",
    "",
    "if change < 0:",
    "    print(-change, \"원이 부족합니다\")",
    "elif change % 10 != 0:",
    "    print(\"거스름돈을 줄 수 없습니다\")",
    "elif change == 0:",
    "    print(\"거스름돈이 없습니다\")",
    "else:",
    "    print(\"거스름돈:\", change, \"원\")",
    "    n500 = change // 500",
    "    rest = change % 500",
    "    n100 = rest // 100",
    "    rest = rest % 100",
    "    n50 = rest // 50",
    "    n10 = rest % 50 // 10",
    "    if n500 > 0:",
    "        print(\"500원:\", n500, \"개\")",
    "    if n100 > 0:",
    "        print(\"100원:\", n100, \"개\")",
    "    if n50 > 0:",
    "        print(\"50원:\", n50, \"개\")",
    "    if n10 > 0:",
    "        print(\"10원:\", n10, \"개\")"
  ]
