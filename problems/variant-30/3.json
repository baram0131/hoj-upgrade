  "solution": [
    "score = [",
    "    [1, \"가윤\", 95, 72, 88],",
    "    [2, \"나현\", 83, 91, 79],",
    "    [3, \"다인\", 67, 85, 94],",
    "    [4, \"라희\", 91, 64, 70],",
    "    [5, \"마준\", 78, 88, 85],",
    "    [6, \"바다\", 88, 95, 62],",
    "    [7, \"사랑\", 72, 79, 91],",
    "    [8, \"아린\", 59, 83, 77]",
    "]",
    "",
    "k = int(input(\"과목 번호 입력: \"))",
    "",
    "a = 0",
    "b = 0",
    "c = 0",
    "d = 0",
    "total = 0",
    "for row in score:",
    "    x = row[k+1]",
    "    total = total + x",
    "    if x >= 90:",
    "        a = a + 1",
    "    elif x >= 80:",
    "        b = b + 1",
    "    elif x >= 70:",
    "        c = c + 1",
    "    else:",
    "        d = d + 1",
    "avg = total / len(score)",
    "",
    "print(\"90점 이상:\", \"*\" * a)",
    "print(\"80점 이상:\", \"*\" * b)",
    "print(\"70점 이상:\", \"*\" * c)",
    "print(\"70점 미만:\", \"*\" * d)",
    "print(\"평균:\", avg)"
  ]
