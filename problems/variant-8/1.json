  "solution": [
    "height = int(input(\"키 입력: \"))",
    "weight = int(input(\"몸무게 입력: \"))",
    "",
    "bmi = weight / (height / 100) ** 2",
    "",
    "if bmi < 18.5:",
    "    print(\"저체중\")",
    "elif bmi < 23:",
    "    print(\"정상\")",
    "elif bmi < 25:",
    "    print(\"과체중\")",
    "else:",
    "    print(\"비만\")"
